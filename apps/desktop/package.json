{
  "name": "skills-desktop",
  "private": true,
  "version": "0.36.0",
  "description": "Visualize installed Skills and symlink status across AI agents",
  "main": "./out/main/index.mjs",
  "author": "Laststance.io",
  "homepage": "https://github.com/laststance/skills-desktop",
  "license": "MIT",
  "scripts": {
    "dev": "ELECTRON_RUN_AS_NODE= electron-vite dev --remote-debugging-port=9222",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "build:mac": "electron-vite build && electron-builder --mac",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:e2e": "E2E_BUILD=1 electron-vite build",
    "test:e2e": "pnpm build:e2e && playwright test --config=e2e/playwright.config.ts",
    "test:e2e:headed": "pnpm build:e2e && playwright test --config=e2e/playwright.config.ts --headed",
    "test:release:macos-window": "node scripts/verify-macos-window-rendering.mjs",
    "test:packaged:backgrounds": "node scripts/verify-packaged-backgrounds.mjs",
    "gen:e2e-snapshot": "E2E_GEN_SNAPSHOT=1 pnpm test:e2e",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0 --concurrency=auto",
    "lint:fix": "eslint . --fix --concurrency=auto",
    "clean": "rm -rf dist out .vite node_modules",
    "release:prepare-assets": "node scripts/prepare-release-assets.mjs",
    "release:bump-website": "node scripts/bump-website-downloads.mjs",
    "release:verify": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "@laststance/redux-storage-middleware": "catalog:",
    "@orpc/client": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/tanstack-query": "catalog:",
    "@pierre/trees": "catalog:",
    "@radix-ui/react-checkbox": "catalog:",
    "@radix-ui/react-dialog": "catalog:",
    "@radix-ui/react-dropdown-menu": "catalog:",
    "@radix-ui/react-scroll-area": "catalog:",
    "@radix-ui/react-separator": "catalog:",
    "@radix-ui/react-slot": "catalog:",
    "@radix-ui/react-tabs": "catalog:",
    "@radix-ui/react-toggle-group": "catalog:",
    "@radix-ui/react-tooltip": "catalog:",
    "@reduxjs/toolkit": "catalog:",
    "@tanstack/react-query": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "electron-updater": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-easy-crop": "catalog:",
    "react-grid-layout": "catalog:",
    "react-markdown": "catalog:",
    "react-redux": "catalog:",
    "react-resizable-panels": "catalog:",
    "react-window": "catalog:",
    "remark-gfm": "catalog:",
    "sharp": "catalog:",
    "shiki": "catalog:",
    "sonner": "catalog:",
    "tailwind-merge": "catalog:",
    "ts-pattern": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@electron/notarize": "catalog:",
    "@laststance/react-next-eslint-plugin": "catalog:",
    "@playwright/test": "catalog:",
    "@rolldown/plugin-babel": "catalog:",
    "@skills-desktop/unsplash-contract": "workspace:*",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/culori": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "code-inspector-plugin": "catalog:",
    "culori": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "electron-devtools-installer": "catalog:",
    "electron-vite": "catalog:",
    "eslint": "catalog:",
    "eslint-config-ts-prefixer": "catalog:",
    "eslint-import-resolver-typescript": "catalog:",
    "eslint-plugin-import-x": "catalog:",
