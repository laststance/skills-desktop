{
  "name": "skills-desktop",
  "private": true,
  "version": "0.34.0",
  "description": "Visualize installed Skills and symlink status across AI agents",
  "main": "./out/main/index.mjs",
  "author": "Laststance.io",
  "homepage": "https://github.com/laststance/skills-desktop",
  "license": "MIT",
  "scripts": {
    "dev": "ELECTRON_RUN_AS_NODE= electron-vite dev --remote-debugging-port=9222",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "build:mac": "electron-vite build && electron-builder --mac",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:e2e": "E2E_BUILD=1 electron-vite build",
    "test:e2e": "pnpm build:e2e && playwright test --config=e2e/playwright.config.ts",
    "test:e2e:headed": "pnpm build:e2e && playwright test --config=e2e/playwright.config.ts --headed",
    "test:release:macos-window": "node scripts/verify-macos-window-rendering.mjs",
    "test:packaged:backgrounds": "node scripts/verify-packaged-backgrounds.mjs",
    "gen:e2e-snapshot": "E2E_GEN_SNAPSHOT=1 pnpm test:e2e",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0 --concurrency=auto",
    "lint:fix": "eslint . --fix --concurrency=auto",
    "clean": "rm -rf dist out .vite node_modules",
    "release:prepare-assets": "node scripts/prepare-release-assets.mjs",
    "release:bump-website": "node scripts/bump-website-downloads.mjs",
    "release:verify": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "@laststance/redux-storage-middleware": "0.5.0",
    "@orpc/client": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/tanstack-query": "catalog:",
    "@pierre/trees": "catalog:",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@reduxjs/toolkit": "^2.13.0",
    "@tanstack/react-query": "^5.105.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.11",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-easy-crop": "^6.2.4",
    "react-grid-layout": "^2.3.0",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.3.0",
    "react-resizable-panels": "^4.15.0",
    "react-window": "^2.5.1",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "ts-pattern": "^5.9.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@electron/notarize": "^3.1.2",
    "@laststance/react-next-eslint-plugin": "^2.4.0",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@skills-desktop/unsplash-contract": "workspace:*",
    "@storybook/addon-a11y": "10.6.4",
    "@storybook/addon-docs": "10.6.4",
    "@storybook/react-vite": "10.6.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/culori": "^4.0.1",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native": "catalog:",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "babel-plugin-react-compiler": "^1.0.0",
    "code-inspector-plugin": "~2.0.9",
    "culori": "^4.0.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-devtools-installer": "^4.0.0",
    "electron-vite": "^6.0.0",
    "eslint": "catalog:",
    "eslint-config-ts-prefixer": "^5.1.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.2",
    "happy-dom": "^21.0.4",
    "playwright": "^1.64.1",
    "storybook": "10.6.4",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.3.5",
    "vitest": "catalog:",
    "vitest-browser-react": "^2.3.0"
  }
}
